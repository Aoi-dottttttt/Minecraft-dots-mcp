# Optional configuration for the Mineflayer MCP server. All have sensible defaults.

# Comma-separated tool-group keys to disable (see README catalog), e.g. creative,villager,enchanting
MCP_DISABLE_GROUPS=

# Max characters returned by any single tool call (output is truncated past this).
MCP_CHARACTER_LIMIT=25000

# Size of the in-memory event ring buffer.
MCP_EVENT_BUFFER=1000

# Minimum spacing (ms) between pushed resource-update / log notifications.
MCP_THROTTLE_MS=250

# Radius (blocks) for proximity-filtered events (entity spawns, sounds).
MCP_PROXIMITY_RADIUS=32

# Default timeout (ms) for long-running actions when the caller omits one.
MCP_ACTION_TIMEOUT_MS=60000

# --- Safety / guardrails (all optional) ---

# Observe-only mode: register just read-only tools (+ lifecycle). No dig/place/chat/combat.
MCP_READ_ONLY=false

# Slash commands blocked by run_command. Setting this REPLACES the built-in default
# (op,deop,ban,kick,stop,whitelist,…). Set to empty to allow ALL commands.
# MCP_COMMAND_DENY=op,deop,ban,ban-ip,kick,stop,whitelist

# Strict allow-list: if non-empty, ONLY these commands are permitted (deny list ignored).
# MCP_COMMAND_ALLOW=tp,time,say

# Allow-list of hosts the bot may connect to (empty = any host allowed).
# MCP_ALLOWED_HOSTS=localhost,play.example.net

# Minimum spacing (ms) between outbound chat/whisper/command sends (anti-spam/kick). 0 = off.
MCP_CHAT_MIN_INTERVAL_MS=0

# Enable the advanced/unsafe `raw` protocol tool group (direct packet send/subscribe). Off by default.
MCP_ENABLE_RAW=false

# --- Screenshots (get_screenshot) ---
MCP_SCREENSHOT_WIDTH=800
MCP_SCREENSHOT_HEIGHT=450
# How long (ms) to let the world render in the browser before capturing.
MCP_SCREENSHOT_LOAD_MS=2500
# Chunk render distance for screenshots.
MCP_VIEW_DISTANCE=4
# Browser channel to use (chrome, msedge, chromium). Empty = auto-detect Chrome then Edge.
# MCP_SCREENSHOT_BROWSER_CHANNEL=chrome
# Explicit browser executable path (overrides channel).
# MCP_SCREENSHOT_EXECUTABLE_PATH=
