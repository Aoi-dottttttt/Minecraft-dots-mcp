{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.G0Osey99/awesome-mineflayer-mcp",
  "title": "Awesome Mineflayer MCP",
  "description": "Control a Mineflayer Minecraft bot with 120+ MCP tools: move, mine, craft, fight, build, and see.",
  "repository": {
    "url": "https://github.com/G0Osey99/awesome-mineflayer-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/G0Osey99/awesome-mineflayer-mcp#readme",
  "version": "1.3.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "awesome-mineflayer-mcp",
      "version": "1.3.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "MCP_DEFAULT_HOST",
          "description": "Server to auto-connect on startup (optional).",
          "isRequired": false
        },
        {
          "name": "MCP_DEFAULT_USERNAME",
          "description": "In-game name (offline) or account email (microsoft).",
          "isRequired": false
        },
        {
          "name": "MCP_DEFAULT_AUTH",
          "description": "Auth mode: offline or microsoft.",
          "isRequired": false
        },
        {
          "name": "MCP_DISABLE_GROUPS",
          "description": "Comma-separated tool-group keys to disable.",
          "isRequired": false
        },
        {
          "name": "MCP_READ_ONLY",
          "description": "Observe-only mode (no world-mutating tools).",
          "isRequired": false
        },
        {
          "name": "MCP_ALLOWED_HOSTS",
          "description": "Comma-separated allow-list of hosts the bot may join.",
          "isRequired": false
        }
      ]
    }
  ]
}
